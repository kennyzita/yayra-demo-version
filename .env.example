NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic — required for PDF parsing (case notes, PA authorizations) and expiry OCR
# HIPAA NOTE: parse-case-note and extract-pdf send client PHI to Anthropic's API.
# You MUST sign a Business Associate Agreement (BAA) with Anthropic before enabling
# those routes. BAAs are available on the Anthropic Enterprise plan (anthropic.com).
# Once the BAA is signed, set ANTHROPIC_BAA_ACKNOWLEDGED=true to unlock the routes.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_BAA_ACKNOWLEDGED=true

# Email (Resend) — get your API key at resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Reliance Care Services <your-verified-sender@yourdomain.com>
# Leave RESEND_FROM unset to use the shared Resend test address (onboarding@resend.dev).
# Set it to a verified sender once your domain is confirmed in the Resend dashboard.
